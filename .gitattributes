# Force LF line endings for Linux files (shell scripts, source, cmake)
Linux/**        text eol=lf
*.sh            text eol=lf

# Batch files must stay CRLF: cmd.exe skips lines after call/label returns in
# LF-only scripts. Stored normalized (LF) in the repo, CRLF on every checkout.
*.bat           text eol=crlf
